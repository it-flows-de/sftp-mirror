#===============================================================================
# sftp-mirror.secrets
#
# Credentials for sftp-mirror.sh. Never commit the real file to Git.
# Usage:     cp sftp-mirror.secrets.example <path from SECRETS_FILE in the config>
#            (default: /root/.secrets/sftp-mirror.secrets), then edit with vi.
# Rights:    chown root:root, chmod 600, directory chmod 700.
# Syntax:    KEY='value' with single quotes - no spaces around the "=".
#            A single quote inside a value is written as '\''
#===============================================================================

# User name on the SFTP server.
REMOTE_USER='your-sftp-user'

# Password on the SFTP server.
# Leave empty ('') if key authentication is used (SSH_KEY_FILE in the config).
REMOTE_PASSWORD='your-sftp-password'
